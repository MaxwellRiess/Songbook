{
  "manifest_version": 3,
  "name": "Songbook Clipper",
  "version": "0.2.1",
  "description": "Clip loaded Ultimate Guitar chord pages into the local Lyrics & Chords Library app.",
  "action": {
    "default_title": "Clip song",
    "default_popup": "popup.html"
  },
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": [
    "https://tabs.ultimate-guitar.com/*",
    "https://www.ultimate-guitar.com/*",
    "http://127.0.0.1:3000/*",
    "http://localhost:3000/*",
    "https://maxwellriess.github.io/Songbook/*"
  ]
}
